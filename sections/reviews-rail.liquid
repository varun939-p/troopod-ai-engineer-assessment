        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_reference",
          "label": "Product reference",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
