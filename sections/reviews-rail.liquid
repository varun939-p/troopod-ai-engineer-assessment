{% comment %}
  Reviews Rail Section - Purelane Homecare
  Scoped CSS with #shopify-section-{{ section.id }} to prevent style bleeding
{% endcomment %}

{% assign section_id = section.id %}
{% assign heading = section.settings.heading %}
{% assign rating = section.settings.rating %}
{% assign review_count = section.settings.review_count %}
{% assign customer_count = section.settings.customer_count %}

<style>
  #shopify-section-{{ section_id }} {
    --reviews-ink: #17102b;
    --reviews-deep: #241a3d;
    --reviews-brand: #4b3a8f;
    --reviews-brand-lt: #6b55b8;
    --reviews-paper: #ece6f7;
    --reviews-paper-2: rgba(236,230,247,.74);
    --reviews-paper-3: rgba(236,230,247,.52);
    --reviews-accent: #f0a03c;
    --reviews-accent-2: #c9761d;
    --reviews-surface: #faf7fd;
    --reviews-g-bg: linear-gradient(158deg,rgba(236,230,247,.15),rgba(75,58,143,.20) 58%,rgba(23,16,43,.28));
    --reviews-g-line: rgba(236,230,247,.22);
    --reviews-g-shadow: 0 26px 74px rgba(18,12,34,.44);
    --reviews-g-inset: inset 0 1px 0 rgba(255,255,255,.24);
    --reviews-r: 26px;
    --reviews-r-sm: 16px;
    --reviews-maxw: 1180px;
    --reviews-sec-y: 34px;
    --reviews-ease: cubic-bezier(.2,.7,.2,1);
    padding: var(--reviews-sec-y) 0;
    background: var(--reviews-ink);
    overflow: hidden;
  }

  #shopify-section-{{ section_id }} .reviews-wrap {
    max-width: var(--reviews-maxw);
    margin: 0 auto;
    padding: 0 18px;
  }

  #shopify-section-{{ section_id }} .reviews-head {
    text-align: center;
    margin-bottom: 30px;
  }

  #shopify-section-{{ section_id }} .reviews-kicker {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--reviews-paper-3);
    display: block;
  }

  #shopify-section-{{ section_id }} .reviews-aggregate {
    font-size: 14px;
    color: var(--reviews-paper-2);
    margin-top: 8px;
  }

  #shopify-section-{{ section_id }} .reviews-aggregate b {
    color: var(--reviews-surface);
    font-weight: 700;
  }

  #shopify-section-{{ section_id }} .reviews-stars {
    color: var(--reviews-accent);
    letter-spacing: -2px;
  }

  /* Reviews Rail */
  #shopify-section-{{ section_id }} .reviews-rail {
    position: relative;
    overflow: hidden;
    margin-top: 30px;
  }

  #shopify-section-{{ section_id }} .reviews-track {
    display: flex;
    gap: 20px;
    animation: scroll 40s linear infinite;
    width: max-content;
  }

  #shopify-section-{{ section_id }} .reviews-track:hover {
    animation-play-state: paused;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Review Card */
  #shopify-section-{{ section_id }} .review-card {
    background: linear-gradient(158deg,rgba(236,230,247,.10),rgba(0,48,46,.22));
    backdrop-filter: blur(18px) saturate(135%);
    -webkit-backdrop-filter: blur(18px) saturate(135%);
    border: 1px solid rgba(236,230,247,.16);
    border-radius: var(--reviews-r);
    box-shadow: 0 18px 48px rgba(18,12,34,.36),inset 0 1px 0 rgba(255,255,255,.16);
    position: relative;
    overflow: hidden;
    padding: 24px;
    min-width: 300px;
    max-width: 300px;
    flex-shrink: 0;
  }

  #shopify-section-{{ section_id }} .review-stars {
    color: var(--reviews-accent);
    font-size: 16px;
    letter-spacing: -2px;
    margin-bottom: 12px;
  }

  #shopify-section-{{ section_id }} .review-title {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: var(--reviews-surface);
    margin: 0 0 12px;
    line-height: 1.3;
  }

  #shopify-section-{{ section_id }} .review-text {
    font-size: 13px;
    color: var(--reviews-paper-2);
    line-height: 1.5;
    margin-bottom: 16px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #shopify-section-{{ section_id }} .review-author {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--reviews-paper-2);
  }

  #shopify-section-{{ section_id }} .review-author svg {
    width: 16px;
    height: 16px;
    color: var(--reviews-accent);
    flex: 0 0 auto;
  }

  #shopify-section-{{ section_id }} .review-author b {
    color: var(--reviews-surface);
    font-weight: 600;
  }

  #shopify-section-{{ section_id }} .review-product {
    color: var(--reviews-paper-3);
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} .review-card {
      min-width: 260px;
      max-width: 260px;
      padding: 20px;
    }
  }
</style>

<section class="reviews-section" id="shopify-section-{{ section_id }}" data-section-id="{{ section_id }}">
  <div class="reviews-wrap">
    
    <div class="reviews-head">
      <span class="reviews-kicker">{{ section.settings.kicker }}</span>
      <div class="reviews-aggregate">
        <span class="reviews-stars">{{ section.settings.stars_display }}</span> 
        <b>{{ rating }}</b> from {{ review_count }}+ reviews
      </div>
      <div class="reviews-aggregate">
        Loved by <b>{{ customer_count }}+</b> homes
      </div>
    </div>

    <div class="reviews-rail" aria-label="Customer reviews">
      <div class="reviews-track">
        {% for block in section.blocks %}
          <article class="review-card" {{ block.shopify_attributes }}>
            
            <div class="review-stars">{{ section.settings.stars_display }}</div>
            
            <h5 class="review-title">{{ block.settings.title }}</h5>
            
            <p class="review-text">{{ block.settings.review_text }}</p>
            
            <div class="review-author">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m5 13 4 4L19 7"/>
              </svg>
              <b>{{ block.settings.author_name }}</b>
              {% if block.settings.product_reference != blank %}
                <span class="review-product">· {{ block.settings.product_reference }}</span>
              {% endif %}
            </div>
            
          </article>
        {% endfor %}
        
        <!-- Duplicate cards for seamless infinite scroll -->
        {% for block in section.blocks %}
          <article class="review-card" aria-hidden="true">
            
            <div class="review-stars">{{ section.settings.stars_display }}</div>
            
            <h5 class="review-title">{{ block.settings.title }}</h5>
            
            <p class="review-text">{{ block.settings.review_text }}</p>
            
            <div class="review-author">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m5 13 4 4L19 7"/>
              </svg>
              <b>{{ block.settings.author_name }}</b>
              {% if block.settings.product_reference != blank %}
                <span class="review-product">· {{ block.settings.product_reference }}</span>
              {% endif %}
            </div>
            
          </article>
        {% endfor %}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Reviews Rail",
  "tag": "section",
  "class": "section-reviews-rail",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count",
      "default": "8,000"
    },
    {
      "type": "text",
      "id": "customer_count",
      "label": "Customer count",
      "default": "12 lakh"
    },
    {
      "type": "text",
      "id": "stars_display",
      "label": "Stars display",
      "default": "★★★★★"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Review title",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review text",
