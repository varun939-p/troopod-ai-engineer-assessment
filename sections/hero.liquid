{% comment %}
  Hero Section - Purelane Homecare
  Scoped CSS with #shopify-section-{{ section.id }} to prevent style bleeding
{% endcomment %}

{% assign section_id = section.id %}
{% assign heading = section.settings.heading %}
{% assign subheading = section.settings.subheading %}
{% assign cta_text = section.settings.cta_text %}
{% assign cta_link = section.settings.cta_link %}
{% assign secondary_cta_text = section.settings.secondary_cta_text %}
{% assign secondary_cta_link = section.settings.secondary_cta_link %}
{% assign featured_product = section.settings.featured_product %}
{% assign badge_1_icon = section.settings.badge_1_icon %}
{% assign badge_1_text = section.settings.badge_1_text %}
{% assign badge_2_icon = section.settings.badge_2_icon %}
{% assign badge_2_text = section.settings.badge_2_text %}
{% assign badge_3_icon = section.settings.badge_3_icon %}
{% assign badge_3_text = section.settings.badge_3_text %}

<style>
  #shopify-section-{{ section_id }} {
    --hero-ink: #17102b;
    --hero-deep: #241a3d;
    --hero-brand: #4b3a8f;
    --hero-brand-lt: #6b55b8;
    --hero-paper: #ece6f7;
    --hero-paper-2: rgba(236,230,247,.74);
    --hero-paper-3: rgba(236,230,247,.52);
    --hero-accent: #f0a03c;
    --hero-accent-2: #c9761d;
    --hero-surface: #faf7fd;
    --hero-g-bg: linear-gradient(158deg,rgba(236,230,247,.15),rgba(75,58,143,.20) 58%,rgba(23,16,43,.28));
    --hero-g-line: rgba(236,230,247,.22);
    --hero-g-shadow: 0 26px 74px rgba(18,12,34,.44);
    --hero-g-inset: inset 0 1px 0 rgba(255,255,255,.24);
    --hero-r: 26px;
    --hero-r-sm: 16px;
    --hero-maxw: 1180px;
    --hero-sec-y: 34px;
    --hero-ease: cubic-bezier(.2,.7,.2,1);
    position: relative;
    z-index: 2;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding: 150px 0 var(--hero-sec-y);
    background: var(--hero-brand);
  }

  #shopify-section-{{ section_id }}::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(102deg,rgba(1,45,42,.68) 0%,rgba(1,45,42,.40) 30%,rgba(1,45,42,.10) 52%,transparent 66%);
  }

  @media (max-width: 900px) {
    #shopify-section-{{ section_id }}::before {
      background: linear-gradient(180deg,rgba(1,45,42,.44) 0%,rgba(1,45,42,.22) 34%,rgba(1,40,38,.60) 100%);
    }
    #shopify-section-{{ section_id }} {
      align-items: flex-end;
      padding-top: 132px;
    }
  }

  #shopify-section-{{ section_id }} .hero-grid {
    max-width: var(--hero-maxw);
    margin: 0 auto;
    padding: 0 18px;
    width: 100%;
    position: relative;
    z-index: 2;
  }

  #shopify-section-{{ section_id }} .hero-copy {
    max-width: 600px;
    position: relative;
    z-index: 3;
  }

  @media (max-width: 1200px) {
    #shopify-section-{{ section_id }} .hero-copy {
      max-width: 470px;
    }
  }

  @media (max-width: 900px) {
    #shopify-section-{{ section_id }} .hero-copy {
      max-width: none;
    }
  }

  #shopify-section-{{ section_id }} .hero-d1 {
    font-family: 'Outfit', system-ui, sans-serif;
    text-transform: uppercase;
    letter-spacing: -.018em;
    font-weight: 800;
    line-height: .87;
    color: var(--hero-surface);
    font-size: clamp(48px, 8.6vw, 112px);
    margin-bottom: 20px;
    text-shadow: 0 6px 40px rgba(2,20,19,.55);
  }

  #shopify-section-{{ section_id }} .hero-lime {
    color: var(--hero-accent);
  }

  #shopify-section-{{ section_id }} .hero-rule {
    display: flex;
    align-items: center;
    gap: 13px;
    margin: 0 0 20px;
    max-width: 270px;
  }

  #shopify-section-{{ section_id }} .hero-rule i {
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg,rgba(236,230,247,.44),transparent);
  }

  #shopify-section-{{ section_id }} .hero-rule svg {
    width: 16px;
    height: 16px;
    color: var(--hero-accent);
    flex: 0 0 auto;
  }

  #shopify-section-{{ section_id }} .hero-lede {
    font-size: clamp(15px, 1.35vw, 17.5px);
    color: var(--hero-paper-2);
    max-width: 44ch;
    line-height: 1.62;
  }

  #shopify-section-{{ section_id }} .hero-cta {
    display: flex;
    gap: 11px;
    flex-wrap: wrap;
    margin-top: 26px;
  }

  #shopify-section-{{ section_id }} .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 46px;
    padding: 0 22px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
    transition: .35s var(--hero-ease);
    white-space: nowrap;
    text-decoration: none;
    font-family: inherit;
    cursor: pointer;
    border: none;
  }

  #shopify-section-{{ section_id }} .hero-btn svg {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
  }

  #shopify-section-{{ section_id }} .hero-btn-primary {
    background: linear-gradient(135deg,var(--hero-accent-2),#5d8d1c);
    color: #08211a;
    box-shadow: 0 12px 30px rgba(201,118,29,.34),inset 0 1px 0 rgba(255,255,255,.34);
  }

  #shopify-section-{{ section_id }} .hero-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px rgba(201,118,29,.44),inset 0 1px 0 rgba(255,255,255,.4);
  }

  #shopify-section-{{ section_id }} .hero-btn-ghost {
    background: rgba(236,230,247,.10);
    border: 1px solid rgba(236,230,247,.30);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--hero-surface);
  }

  #shopify-section-{{ section_id }} .hero-btn-ghost:hover {
    background: rgba(236,230,247,.18);
    transform: translateY(-2px);
  }

  #shopify-section-{{ section_id }} .hero-btn:focus-visible {
    outline: 2px solid var(--hero-accent);
    outline-offset: 3px;
    border-radius: 6px;
  }

  /* Badges - Desktop */
  #shopify-section-{{ section_id }} .hero-badges {
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    width: 96px;
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 8px;
    border-radius: 20px;
    background: linear-gradient(158deg,rgba(236,230,247,.10),rgba(0,48,46,.22));
    backdrop-filter: blur(18px) saturate(135%);
    -webkit-backdrop-filter: blur(18px) saturate(135%);
    border: 1px solid rgba(236,230,247,.16);
    box-shadow: 0 18px 48px rgba(18,12,34,.36),inset 0 1px 0 rgba(255,255,255,.16);
  }

  #shopify-section-{{ section_id }} .hero-badge {
    text-align: center;
    padding: 11px 4px;
  }

  #shopify-section-{{ section_id }} .hero-badge + .hero-badge {
    border-top: 1px solid rgba(236,230,247,.14);
  }

  #shopify-section-{{ section_id }} .hero-badge-icon {
    width: 38px;
    height: 38px;
    margin: 0 auto 8px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(236,230,247,.10);
    border: 1px solid rgba(236,230,247,.22);
    color: var(--hero-accent);
  }

  #shopify-section-{{ section_id }} .hero-badge-icon svg {
    width: 19px;
    height: 19px;
  }

  #shopify-section-{{ section_id }} .hero-badge-text {
    display: block;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: .11em;
    text-transform: uppercase;
    color: var(--hero-paper-2);
    line-height: 1.34;
  }

  @media (max-width: 900px) {
    #shopify-section-{{ section_id }} .hero-badges {
      display: none;
    }
  }

  /* Mobile Badge Strip */
  #shopify-section-{{ section_id }} .hero-badgestrip {
    display: flex;
    gap: 8px;
    margin-top: 24px;
  }

  #shopify-section-{{ section_id }} .hero-badgestrip-item {
    flex: 1;
    text-align: center;
    padding: 11px 6px;
    border-radius: 14px;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--hero-paper-2);
    line-height: 1.3;
    background: linear-gradient(158deg,rgba(236,230,247,.10),rgba(0,48,46,.22));
    backdrop-filter: blur(18px) saturate(135%);
    -webkit-backdrop-filter: blur(18px) saturate(135%);
    border: 1px solid rgba(236,230,247,.16);
  }

  #shopify-section-{{ section_id }} .hero-badgestrip-item svg {
    width: 18px;
    height: 18px;
    margin: 0 auto 6px;
    color: var(--hero-accent);
  }

  @media (min-width: 901px) {
    #shopify-section-{{ section_id }} .hero-badgestrip {
      display: none;
    }
  }

  /* Product Showcase */
  #shopify-section-{{ section_id }} .hero-prod {
    position: absolute;
    right: 2%;
    bottom: 28px;
    width: min(50vw, 560px);
    z-index: 2;
    filter: drop-shadow(0 34px 54px rgba(2,20,19,.6));
  }

  @media (max-width: 1200px) {
    #shopify-section-{{ section_id }} .hero-prod {
      width: min(44vw, 440px);
      right: 3%;
    }
  }

  @media (max-width: 900px) {
    #shopify-section-{{ section_id }} .hero-prod {
      position: relative;
      right: auto;
      bottom: auto;
      width: min(88vw, 420px);
      margin: 20px auto 0;
    }
  }

  #shopify-section-{{ section_id }} .hero-prod img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>

<section class="hero" id="shopify-section-{{ section_id }}" data-section-id="{{ section_id }}">
  <div class="hero-grid">
    
    <!-- Desktop Badges -->
    <div class="hero-badges" aria-label="Product promises">
      <div class="hero-badge">
        <span class="hero-badge-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
            <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>
        </span>
        <span class="hero-badge-text">{{ badge_1_text }}</span>
      </div>
      <div class="hero-badge">
        <span class="hero-badge-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
            <path d="m9 12 2.2 2.2L15.4 10"/>
          </svg>
        </span>
        <span class="hero-badge-text">{{ badge_2_text }}</span>
      </div>
      <div class="hero-badge">
        <span class="hero-badge-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="8.4"/>
            <path d="M6.4 17.6 17.6 6.4"/>
          </svg>
        </span>
        <span class="hero-badge-text">{{ badge_3_text }}</span>
      </div>
    </div>

    <!-- Hero Copy -->
    <div class="hero-copy">
      <h1 class="hero-d1">{{ heading }}</h1>
      
      <div class="hero-rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>
      
      <p class="hero-lede">{{ subheading }}</p>
      
      <div class="hero-cta">
        {% if cta_link != blank and cta_text != blank %}
          <a href="{{ cta_link }}" class="hero-btn hero-btn-primary" aria-label="{{ cta_text }}">
            {{ cta_text }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h13m-5-6 6 6-6 6"/>
            </svg>
          </a>
        {% endif %}
        
        {% if secondary_cta_link != blank and secondary_cta_text != blank %}
          <a href="{{ secondary_cta_link }}" class="hero-btn hero-btn-ghost" aria-label="{{ secondary_cta_text }}">
            {{ secondary_cta_text }}
          </a>
        {% endif %}
      </div>

      <!-- Mobile Badge Strip -->
      <div class="hero-badgestrip">
        <div class="hero-badgestrip-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
            <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>
          {{ badge_1_text }}
        </div>
        <div class="hero-badgestrip-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
            <path d="m9 12 2.2 2.2L15.4 10"/>
          </svg>
          {{ badge_2_text }}
        </div>
        <div class="hero-badgestrip-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="8.4"/>
            <path d="M6.4 17.6 17.6 6.4"/>
          </svg>
          {{ badge_3_text }}
        </div>
      </div>
    </div>

    <!-- Featured Product -->
    {% if featured_product != blank %}
      <div class="hero-prod">
        {% assign product = all_products[featured_product] %}
        {% if product != blank %}
          {% if product.featured_image %}
            {{
              product.featured_image
              | image_url: width: 560
              | image_tag: 
                loading: 'lazy',
                alt: product.featured_image.alt,
                widths: '280, 420, 560',
                class: 'hero-product-image'
            }}
          {% endif %}
        {% endif %}
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Hero Section",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clean<br>That<br><span class=\"hero-lime\">Lasts</span>",
      "info": "Use <br> for line breaks and <span class=\"hero-lime\"> for highlighted text"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "header",
      "content": "Primary Call to Action"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Secondary Call to Action"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA Text",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary CTA Link"
    },
    {
      "type": "header",
      "content": "Featured Product"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Featured Product"
    },
    {
      "type": "header",
      "content": "Product Badges"
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Badge 1 Text",
      "default": "Plant<br>powered"
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Badge 2 Text",
      "default": "Safe for<br>kids & pets"
    },
    {
      "type": "text",
      "id": "badge_3_text",
      "label": "Badge 3 Text",
      "default": "Zero harsh<br>chemicals"
    }
  ],
  "presets": [
    {
      "name": "Hero Section",
      "category": "PureLane"
    }
  ]
}
{% endschema %}