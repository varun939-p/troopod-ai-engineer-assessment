{% comment %}
  Best-selling Combos Section - Purelane Homecare
  Scoped CSS with #shopify-section-{{ section.id }} to prevent style bleeding
{% endcomment %}

{% assign section_id = section.id %}
{% assign heading = section.settings.heading %}
{% assign subheading = section.settings.subheading %}
{% assign kicker = section.settings.kicker %}

<style>
  #shopify-section-{{ section_id }} {
    --combos-ink: #17102b;
    --combos-deep: #241a3d;
    --combos-brand: #4b3a8f;
    --combos-brand-lt: #6b55b8;
    --combos-paper: #ece6f7;
    --combos-paper-2: rgba(236,230,247,.74);
    --combos-paper-3: rgba(236,230,247,.52);
    --combos-accent: #f0a03c;
    --combos-accent-2: #c9761d;
    --combos-surface: #faf7fd;
    --combos-g-bg: linear-gradient(158deg,rgba(236,230,247,.15),rgba(75,58,143,.20) 58%,rgba(23,16,43,.28));
    --combos-g-line: rgba(236,230,247,.22);
    --combos-g-shadow: 0 26px 74px rgba(18,12,34,.44);
    --combos-g-inset: inset 0 1px 0 rgba(255,255,255,.24);
    --combos-r: 26px;
    --combos-r-sm: 16px;
    --combos-maxw: 1180px;
    --combos-sec-y: 34px;
    --combos-ease: cubic-bezier(.2,.7,.2,1);
    padding: var(--combos-sec-y) 0;
    background: var(--combos-ink);
  }

  #shopify-section-{{ section_id }} .combos-wrap {
    max-width: var(--combos-maxw);
    margin: 0 auto;
    padding: 0 18px;
  }

  #shopify-section-{{ section_id }} .combos-panel-head {
    text-align: center;
    margin-bottom: 40px;
  }

  #shopify-section-{{ section_id }} .combos-kicker {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--combos-paper-3);
    display: block;
  }

  #shopify-section-{{ section_id }} .combos-heading {
    font-family: 'Outfit', system-ui, sans-serif;
    text-transform: uppercase;
    letter-spacing: -.018em;
    font-weight: 800;
    line-height: .94;
    color: var(--combos-surface);
    font-size: clamp(30px, 4.6vw, 54px);
    margin-top: 12px;
  }

  #shopify-section-{{ section_id }} .combos-rule {
    display: flex;
    align-items: center;
    gap: 13px;
    margin: 20px auto 0;
    max-width: 270px;
    justify-content: center;
  }

  #shopify-section-{{ section_id }} .combos-rule i {
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg,rgba(236,230,247,.44),transparent);
  }

  #shopify-section-{{ section_id }} .combos-rule svg {
    width: 16px;
    height: 16px;
    color: var(--combos-accent);
    flex: 0 0 auto;
  }

  #shopify-section-{{ section_id }} .combos-subheading {
    font-size: clamp(15px, 1.35vw, 17.5px);
    color: var(--combos-paper-2);
    max-width: 44ch;
    margin: 14px auto 0;
    line-height: 1.62;
  }

  /* Combo Rail */
  #shopify-section-{{ section_id }} .combos-rail {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 30px;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} .combos-rail {
      grid-template-columns: 1fr;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 20px;
    }
  }

  /* Combo Card */
  #shopify-section-{{ section_id }} .combo-card {
    background: var(--combos-g-bg);
    backdrop-filter: blur(24px) saturate(150%);
    -webkit-backdrop-filter: blur(24px) saturate(150%);
    border: 1px solid var(--combos-g-line);
    border-radius: var(--combos-r);
    box-shadow: var(--combos-g-shadow), var(--combos-g-inset);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s var(--combos-ease);
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} .combo-card {
      scroll-snap-align: start;
      min-width: 280px;
    }
  }

  #shopify-section-{{ section_id }} .combo-card:hover {
    transform: translateY(-4px);
  }

  #shopify-section-{{ section_id }} .combo-card::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background: linear-gradient(115deg,rgba(255,255,255,.16),transparent 30%,transparent 72%,rgba(240,160,60,.07));
  }

  #shopify-section-{{ section_id }} .combo-card.hero-combo {
    border: 2px solid var(--combos-accent);
  }

  /* Combo Tray */
  #shopify-section-{{ section_id }} .combo-tray {
    padding: 16px;
    position: relative;
    background: rgba(236,230,247,.05);
  }

  #shopify-section-{{ section_id }} .combo-save {
    position: absolute;
    top: 8px;
    right: 8px;
    background: var(--combos-accent);
    color: var(--combos-ink);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
    z-index: 2;
  }

  #shopify-section-{{ section_id }} .combo-flag {
    position: absolute;
    top: 8px;
    left: 8px;
    background: var(--combos-brand);
    color: var(--combos-surface);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
    z-index: 2;
  }

  #shopify-section-{{ section_id }} .combo-stack {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
  }

  #shopify-section-{{ section_id }} .combo-item {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
  }

  #shopify-section-{{ section_id }} .combo-product-image {
    width: 40px;
    height: 40px;
    object-fit: contain;
    border-radius: var(--combos-r-sm);
  }

  #shopify-section-{{ section_id }} .combo-product-name {
    font-size: 11px;
    color: var(--combos-paper-2);
    line-height: 1.3;
    flex: 1;
  }

  #shopify-section-{{ section_id }} .combo-plus {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--combos-accent);
    font-size: 16px;
    font-weight: 700;
  }

  /* Combo Body */
  #shopify-section-{{ section_id }} .combo-body {
    padding: 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section_id }} .combo-title {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--combos-surface);
    margin: 0 0 8px;
    line-height: 1.2;
  }

  #shopify-section-{{ section_id }} .combo-count {
    font-size: 12px;
    color: var(--combos-paper-2);
    margin-bottom: 12px;
  }

  #shopify-section-{{ section_id }} .combo-description {
    font-size: 13px;
    color: var(--combos-paper-2);
    line-height: 1.5;
    margin-bottom: 16px;
    flex: 1;
  }

  #shopify-section-{{ section_id }} .combo-price-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section_id }} .combo-price-current {
    font-size: 20px;
    font-weight: 700;
    color: var(--combos-surface);
  }

  #shopify-section-{{ section_id }} .combo-price-compare {
    font-size: 14px;
    color: var(--combos-paper-2);
    text-decoration: line-through;
  }

  #shopify-section-{{ section_id }} .combo-price-save {
    font-size: 12px;
    font-weight: 600;
    color: var(--combos-accent);
  }

  #shopify-section-{{ section_id }} .combo-fine {
    font-size: 11px;
    color: var(--combos-paper-3);
    margin-bottom: 16px;
  }

  #shopify-section-{{ section_id }} .combo-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 46px;
    padding: 0 22px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
    transition: .35s var(--combos-ease);
    white-space: nowrap;
    text-decoration: none;
    font-family: inherit;
    cursor: pointer;
    border: none;
    justify-content: center;
    width: 100%;
  }

  #shopify-section-{{ section_id }} .combo-cta svg {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
  }

  #shopify-section-{{ section_id }} .combo-cta-primary {
    background: linear-gradient(135deg,var(--combos-accent-2),#5d8d1c);
    color: #08211a;
    box-shadow: 0 12px 30px rgba(201,118,29,.34),inset 0 1px 0 rgba(255,255,255,.34);
  }

  #shopify-section-{{ section_id }} .combo-cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px rgba(201,118,29,.44),inset 0 1px 0 rgba(255,255,255,.4);
  }

  #shopify-section-{{ section_id }} .combo-cta-ghost {
    background: rgba(236,230,247,.10);
    border: 1px solid rgba(236,230,247,.30);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--combos-surface);
  }

  #shopify-section-{{ section_id }} .combo-cta-ghost:hover {
    background: rgba(236,230,247,.18);
    transform: translateY(-2px);
  }

  #shopify-section-{{ section_id }} .combo-cta:focus-visible {
    outline: 2px solid var(--combos-accent);
    outline-offset: 3px;
    border-radius: 6px;
  }

  /* Swipe Cue */
  #shopify-section-{{ section_id }} .combos-swipe-cue {
    display: none;
    text-align: center;
    margin-top: 16px;
    font-size: 12px;
    color: var(--combos-paper-3);
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} .combos-swipe-cue {
      display: flex;
    }
  }

  #shopify-section-{{ section_id }} .combos-rail-note {
    text-align: center;
    font-size: 12px;
    color: var(--combos-paper-3);
    margin-top: 16px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
</style>

<section class="combos-section" id="shopify-section-{{ section_id }}" data-section-id="{{ section_id }}">
  <div class="combos-wrap">
    
    <div class="combos-panel-head">
      <span class="combos-kicker">{{ kicker }}</span>
      <h2 class="combos-heading">{{ heading }}</h2>
      
      <div class="combos-rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>
      
      {% if subheading != blank %}
        <p class="combos-subheading">{{ subheading }}</p>
      {% endif %}
    </div>

    <div class="combos-rail">
      {% for block in section.blocks %}
        {% assign combo_product_1 = all_products[block.settings.product_1] %}
        {% assign combo_product_2 = all_products[block.settings.product_2] %}
        {% assign combo_product_3 = all_products[block.settings.product_3] %}
        
        <article class="combo-card {% if block.settings.featured %}hero-combo{% endif %}" {{ block.shopify_attributes }}>
          
          <div class="combo-tray">
            {% if block.settings.show_savings %}
              <span class="combo-save">You save {{ block.settings.savings_amount }}</span>
            {% endif %}
            
            {% if block.settings.flag_text != blank %}
              <span class="combo-flag">{{ block.settings.flag_text }}</span>
            {% endif %}
            
            <div class="combo-stack">
              {% if combo_product_1 != blank %}
                <div class="combo-item">
                  {% if combo_product_1.featured_image %}
                    {{
                      combo_product_1.featured_image
                      | image_url: width: 80
                      | image_tag: 
                        loading: 'lazy',
                        alt: combo_product_1.featured_image.alt,
                        widths: '40, 80',
                        class: 'combo-product-image'
                    }}
                  {% endif %}
                  <span class="combo-product-name">{{ combo_product_1.title }}</span>
                </div>
              {% endif %}
              
              {% if combo_product_2 != blank %}
                <span class="combo-plus" aria-hidden="true">+</span>
                <div class="combo-item">
                  {% if combo_product_2.featured_image %}
                    {{
                      combo_product_2.featured_image
                      | image_url: width: 80
                      | image_tag: 
                        loading: 'lazy',
                        alt: combo_product_2.featured_image.alt,
                        widths: '40, 80',
                        class: 'combo-product-image'
                    }}
                  {% endif %}
                  <span class="combo-product-name">{{ combo_product_2.title }}</span>
                </div>
              {% endif %}
              
              {% if combo_product_3 != blank %}
                <span class="combo-plus" aria-hidden="true">+</span>
                <div class="combo-item">
                  {% if combo_product_3.featured_image %}
                    {{
                      combo_product_3.featured_image
                      | image_url: width: 80
                      | image_tag: 
                        loading: 'lazy',
                        alt: combo_product_3.featured_image.alt,
                        widths: '40, 80',
                        class: 'combo-product-image'
                    }}
                  {% endif %}
                  <span class="combo-product-name">{{ combo_product_3.title }}</span>
                </div>
              {% endif %}
            </div>
          </div>
          
          <div class="combo-body">
            <h3 class="combo-title">{{ block.settings.title }}</h3>
            <div class="combo-count">
              {% assign product_count = 0 %}
              {% if combo_product_1 != blank %}{% assign product_count = product_count | plus: 1 %}{% endif %}
              {% if combo_product_2 != blank %}{% assign product_count = product_count | plus: 1 %}{% endif %}
              {% if combo_product_3 != blank %}{% assign product_count = product_count | plus: 1 %}{% endif %}
              {{ product_count }} products
            </div>
            
            <p class="combo-description">{{ block.settings.description }}</p>
            
            <div class="combo-price-row">
              <span class="combo-price-current">{{ block.settings.price }}</span>
              {% if block.settings.compare_price != blank %}
                <span class="combo-price-compare">{{ block.settings.compare_price }}</span>
              {% endif %}
              {% if block.settings.savings_text != blank %}
                <span class="combo-price-save">{{ block.settings.savings_text }}</span>
              {% endif %}
            </div>
            
            <div class="combo-fine">{{ block.settings.fine_print }}</div>
            
            <a href="{{ block.settings.cta_link }}" class="combo-cta {% if block.settings.featured %}combo-cta-primary{% else %}combo-cta-ghost{% endif %}" aria-label="{{ block.settings.cta_text }}">
              {{ block.settings.cta_text }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h13m-5-6 6 6-6 6"/>
              </svg>
            </a>
          </div>
          
        </article>
      {% endfor %}
    </div>

    <div class="combos-swipe-cue" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
        <path d="M5 12h13m-5-6 6 6-6 6"/>
      </svg>
      Swipe for more combos
    </div>

    {% if section.settings.note_text != blank %}
      <p class="combos-rail-note">{{ section.settings.note_text }}</p>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Best-selling Combos",
  "tag": "section",
  "class": "section-combos",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "textarea",
      "id": "note_text",
      "label": "Note Text",
      "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay."
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        {
          "type": "checkbox",
          "id": "featured",
          "default": false,
          "label": "Featured combo"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Combo title",
          "default": "Kitchen essentials"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Includes: Foaming Kitchen Cleaner, Dishwash Gel & Tap Cleaner. Everything for a sparkling kitchen, no need to pick separately."
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3 (optional)"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹499"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare at price",
          "default": "₹897"
        },
        {
          "type": "checkbox",
          "id": "show_savings",
          "default": true,
          "label": "Show savings badge"
        },
        {
          "type": "text",
          "id": "savings_amount",
          "label": "Savings amount",
          "default": "₹398"
        },
        {
          "type": "text",
          "id": "savings_text",
          "label": "Savings text",
          "default": "Save ₹398"
        },
        {
          "type": "text",
          "id": "flag_text",
          "label": "Flag text",
          "default": ""
        },
        {
          "type": "text",
          "id": "fine_print",
          "label": "Fine print",
          "default": "Inclusive of all taxes · COD available"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA button text",
          "default": "Shop bundle"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "CTA button link",
          "default": "#bundles"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best-selling Combos",
      "category": "PureLane",
      "blocks": [
        {
          "type": "combo"
        },
        {
          "type": "combo"
        },
        {
          "type": "combo"
        }
      ]
    }
  ]
}
{% endschema %}