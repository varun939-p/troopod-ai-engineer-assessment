{% comment %}
  Shop / Product Grid Section - Purelane Homecare
  Scoped CSS with #shopify-section-{{ section.id }} to prevent style bleeding
{% endcomment %}

{% assign section_id = section.id %}
{% assign collection = collections[section.settings.collection] %}
{% assign heading = section.settings.heading %}
{% assign subheading = section.settings.subheading %}
{% assign products_to_show = section.settings.products_to_show %}
{% assign show_rating = section.settings.show_rating %}
{% assign show_badges = section.settings.show_badges %}

<style>
  #shopify-section-{{ section_id }} {
    --shop-ink: #17102b;
    --shop-deep: #241a3d;
    --shop-brand: #4b3a8f;
    --shop-brand-lt: #6b55b8;
    --shop-paper: #ece6f7;
    --shop-paper-2: rgba(236,230,247,.74);
    --shop-paper-3: rgba(236,230,247,.52);
    --shop-accent: #f0a03c;
    --shop-accent-2: #c9761d;
    --shop-surface: #faf7fd;
    --shop-g-bg: linear-gradient(158deg,rgba(236,230,247,.15),rgba(75,58,143,.20) 58%,rgba(23,16,43,.28));
    --shop-g-line: rgba(236,230,247,.22);
    --shop-g-shadow: 0 26px 74px rgba(18,12,34,.44);
    --shop-g-inset: inset 0 1px 0 rgba(255,255,255,.24);
    --shop-r: 26px;
    --shop-r-sm: 16px;
    --shop-maxw: 1180px;
    --shop-sec-y: 34px;
    --shop-ease: cubic-bezier(.2,.7,.2,1);
    padding: var(--shop-sec-y) 0;
    background: var(--shop-ink);
  }

  #shopify-section-{{ section_id }} .shop-wrap {
    max-width: var(--shop-maxw);
    margin: 0 auto;
    padding: 0 18px;
  }

  #shopify-section-{{ section_id }} .shop-panel-head {
    text-align: center;
    margin-bottom: 40px;
  }

  #shopify-section-{{ section_id }} .shop-kicker {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--shop-paper-3);
    display: block;
  }

  #shopify-section-{{ section_id }} .shop-heading {
    font-family: 'Outfit', system-ui, sans-serif;
    text-transform: uppercase;
    letter-spacing: -.018em;
    font-weight: 800;
    line-height: .94;
    color: var(--shop-surface);
    font-size: clamp(30px, 4.6vw, 54px);
    margin-top: 12px;
  }

  #shopify-section-{{ section_id }} .shop-rule {
    display: flex;
    align-items: center;
    gap: 13px;
    margin: 20px auto 0;
    max-width: 270px;
    justify-content: center;
  }

  #shopify-section-{{ section_id }} .shop-rule i {
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg,rgba(236,230,247,.44),transparent);
  }

  #shopify-section-{{ section_id }} .shop-rule svg {
    width: 16px;
    height: 16px;
    color: var(--shop-accent);
    flex: 0 0 auto;
  }

  #shopify-section-{{ section_id }} .shop-subheading {
    font-size: clamp(15px, 1.35vw, 17.5px);
    color: var(--shop-paper-2);
    max-width: 44ch;
    margin: 14px auto 0;
    line-height: 1.62;
  }

  /* Product Grid */
  #shopify-section-{{ section_id }} .shop-shelf {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px;
    margin-top: 30px;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} .shop-shelf {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 16px;
    }
  }

  /* Product Card */
  #shopify-section-{{ section_id }} .shop-card {
    background: var(--shop-g-bg);
    backdrop-filter: blur(24px) saturate(150%);
    -webkit-backdrop-filter: blur(24px) saturate(150%);
    border: 1px solid var(--shop-g-line);
    border-radius: var(--shop-r);
    box-shadow: var(--shop-g-shadow), var(--shop-g-inset);
    position: relative;
    overflow: hidden;
    padding: 20px;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s var(--shop-ease);
  }

  #shopify-section-{{ section_id }} .shop-card:hover {
    transform: translateY(-4px);
  }

  #shopify-section-{{ section_id }} .shop-card::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background: linear-gradient(115deg,rgba(255,255,255,.16),transparent 30%,transparent 72%,rgba(240,160,60,.07));
  }

  #shopify-section-{{ section_id }} .shop-shot {
    position: relative;
    margin-bottom: 16px;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 200px;
  }

  #shopify-section-{{ section_id }} .shop-pill {
    position: absolute;
    top: 8px;
    left: 8px;
    background: var(--shop-accent);
    color: var(--shop-ink);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
    z-index: 2;
  }

  #shopify-section-{{ section_id }} .shop-product-image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--shop-r-sm);
  }

  #shopify-section-{{ section_id }} .shop-product-title {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: var(--shop-surface);
    margin: 0 0 8px;
    line-height: 1.3;
    text-transform: none;
    letter-spacing: normal;
  }

  #shopify-section-{{ section_id }} .shop-product-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  #shopify-section-{{ section_id }} .shop-product-title a:hover {
    color: var(--shop-accent);
  }

  #shopify-section-{{ section_id }} .shop-rating {
    font-size: 13px;
    color: var(--shop-paper-2);
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  #shopify-section-{{ section_id }} .shop-rating-stars {
    color: var(--shop-accent);
    letter-spacing: -2px;
  }

  #shopify-section-{{ section_id }} .shop-rating-count {
    font-size: 12px;
  }

  #shopify-section-{{ section_id }} .shop-price {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section_id }} .shop-price-current {
    font-size: 18px;
    font-weight: 700;
    color: var(--shop-surface);
  }

  #shopify-section-{{ section_id }} .shop-price-compare {
    font-size: 14px;
    color: var(--shop-paper-2);
    text-decoration: line-through;
  }

  #shopify-section-{{ section_id }} .shop-price-discount {
    font-size: 12px;
    font-weight: 600;
    color: var(--shop-accent);
    background: rgba(240,160,60,.1);
    padding: 2px 8px;
    border-radius: 4px;
  }

  #shopify-section-{{ section_id }} .shop-add-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 38px;
    padding: 0 18px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    transition: .35s var(--shop-ease);
    white-space: nowrap;
    text-decoration: none;
    font-family: inherit;
    cursor: pointer;
    border: none;
    background: rgba(236,230,247,.10);
    border: 1px solid rgba(236,230,247,.30);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--shop-surface);
    margin-top: auto;
    width: 100%;
  }

  #shopify-section-{{ section_id }} .shop-add-btn:hover {
    background: rgba(236,230,247,.18);
    transform: translateY(-2px);
  }

  #shopify-section-{{ section_id }} .shop-add-btn:focus-visible {
    outline: 2px solid var(--shop-accent);
    outline-offset: 3px;
    border-radius: 6px;
  }

  /* Sold Out State */
  #shopify-section-{{ section_id }} .shop-card--sold-out {
    opacity: 0.7;
  }

  #shopify-section-{{ section_id }} .shop-card--sold-out .shop-add-btn {
    background: rgba(236,230,247,.05);
    border-color: rgba(236,230,247,.15);
    cursor: not-allowed;
  }

  #shopify-section-{{ section_id }} .shop-card--sold-out .shop-add-btn:hover {
    transform: none;
  }

  /* No Image State */
  #shopify-section-{{ section_id }} .shop-card--no-image .shop-shot {
    background: rgba(236,230,247,.05);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section_id }} .shop-card--no-image .shop-shot::before {
    content: "No Image";
    color: var(--shop-paper-3);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .1em;
  }

  /* Long Title Handling */
  #shopify-section-{{ section_id }} .shop-product-title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    min-height: 42px;
  }
</style>

<section class="shop-section" id="shopify-section-{{ section_id }}" data-section-id="{{ section_id }}">
  <div class="shop-wrap">
    
    <div class="shop-panel-head">
      <span class="shop-kicker">{{ section.settings.kicker }}</span>
      <h2 class="shop-heading">{{ heading }}</h2>
      
      <div class="shop-rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>
      
      {% if subheading != blank %}
        <p class="shop-subheading">{{ subheading }}</p>
      {% endif %}
    </div>

    {% if collection != blank %}
      <div class="shop-shelf">
        {% for product in collection.products limit: products_to_show %}
          <article class="shop-card {% unless product.available %}shop-card--sold-out{% endunless %} {% unless product.featured_image %}shop-card--no-image{% endunless %}">
            
            <div class="shop-shot">
              {% if show_badges and product.tags contains 'best-seller' %}
                <span class="shop-pill">Best seller</span>
              {% elsif show_badges and product.tags contains 'top-rated' %}
                <span class="shop-pill">Top rated</span>
              {% elsif show_badges and product.tags contains 'new' %}
                <span class="shop-pill">New</span>
              {% endif %}
              
              {% if product.featured_image %}
                {{
                  product.featured_image
                  | image_url: width: 400
                  | image_tag: 
                    loading: 'lazy',
                    alt: product.featured_image.alt,
                    widths: '200, 300, 400',
                    class: 'shop-product-image'
                }}
              {% endif %}
            </div>
            
            <h4 class="shop-product-title">
              <a href="{{ product.url }}" aria-label="View {{ product.title }}">
                {{ product.title }}
              </a>
            </h4>
            
            {% if show_rating %}
              <div class="shop-rating">
                <span class="shop-rating-stars">★★★★★</span>
                {% if product.metafields.reviews.rating_count != blank %}
                  <span class="shop-rating-count">· {{ product.metafields.reviews.rating_count }} reviews</span>
                {% endif %}
              </div>
            {% endif %}
            
            <div class="shop-price">
              <span class="shop-price-current">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="shop-price-compare">{{ product.compare_at_price | money }}</span>
                {% assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                <span class="shop-price-discount">{{ discount }}% off</span>
              {% endif %}
            </div>
            
            <form method="post" action="/cart/add" class="shop-add-form">
              <input type="hidden" name="id" value="{{ product.variants.first.id }}">
              <button type="submit" class="shop-add-btn" {% unless product.available %}disabled{% endunless %} aria-label="{% if product.available %}Add {{ product.title }} to cart{% else %}{{ product.title }} is sold out{% endif %}">
                {% if product.available %}
                  Add to cart
                {% else %}
                  Sold out
                {% endif %}
              </button>
            </form>
            
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="shop-shelf">
        <p style="text-align: center; color: var(--shop-paper-2); padding: 40px;">Please select a collection in the section settings.</p>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Shop Product Grid",
  "tag": "section",
  "class": "section-shop-grid",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": true,
      "label": "Show ratings"
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "default": true,
      "label": "Show product badges",
      "info": "Requires products to have tags: 'best-seller', 'top-rated', or 'new'"
    }
  ],
  "presets": [
    {
      "name": "Shop Product Grid",
      "category": "PureLane"
    }
  ]
}
{% endschema %}